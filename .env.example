# Copy to .env and fill in the secrets. Never commit .env.

# Provider selection: an explicit LLM_PROVIDER with its key wins; otherwise
# GEMINI_API_KEY -> OPENAI_API_KEY -> local_synth. Remote failures fall back
# to local_synth, so /ask still returns a cited answer.
LLM_PROVIDER=local_synth
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# Live AQI fetch is enabled only when this key is set; otherwise the
# user-entered band is authoritative.
AQI_API_KEY=

STORE_BACKEND=sqlite
DATABASE_URL=sqlite:///./data/air.db
AUTH_SECRET=
FRONTEND_ORIGIN=http://localhost:8000

RATE_LIMIT_PER_MIN=200
MAX_RATE_BUCKETS=10000
# Enable only behind a trusted reverse proxy that sets X-Forwarded-For. The
# limiter keys on the proxy-appended rightmost hop; raise TRUSTED_PROXY_HOPS
# only for a known chain of trusted proxies.
TRUST_PROXY=false
TRUSTED_PROXY_HOPS=1
MAX_UPLOAD_BYTES=10485760
MAX_DOCUMENTS=10

PORT=8000
LOG_LEVEL=info
